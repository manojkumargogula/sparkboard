# Optional settings for `docker compose up` and `make dev`. Copy to .env (never commit .env).
ADMIN_TOKEN=change-me-locally

# AI "Sharpen" in the composer: anthropic | openai | none
AI_PROVIDER=none
AI_API_KEY=

# Google sign-in: public OAuth client ID. AUTH_REQUIRED=true makes writes need it.
GOOGLE_CLIENT_ID=
AUTH_REQUIRED=false
