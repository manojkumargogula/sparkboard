# Copy to .env for docker compose / local dev. Never commit .env.
POSTGRES_PASSWORD=sparkboard
ADMIN_TOKEN=change-me-locally
# Optional AI features (Sharpen in the composer): anthropic | openai | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Google sign-in (public OAuth client ID). AUTH_REQUIRED=true makes posting/voting need it.
GOOGLE_CLIENT_ID=
AUTH_REQUIRED=false
